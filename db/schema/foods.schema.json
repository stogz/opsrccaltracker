{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opsrccaltracker food catalog",
  "description": "Generated by tools/build-catalog.mjs. Every value is per 100 g; portions carry gram weights. Do not hand-edit the catalog — edit data/overrides/ and rebuild.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "kcal", "portions"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "integer", "description": "USDA fdcId — the join key back to the source release" },
      "name": { "type": "string", "minLength": 1 },
      "cat": { "type": "string", "description": "USDA food category" },
      "kcal": { "type": "number", "minimum": 0, "maximum": 900, "description": "Per 100 g. 900 is pure fat; anything above it is a data error." },
      "protein": { "type": ["number", "null"], "minimum": 0 },
      "fat": { "type": ["number", "null"], "minimum": 0 },
      "carbs": { "type": ["number", "null"], "minimum": 0 },
      "fiber": { "type": ["number", "null"], "minimum": 0 },
      "sodium": { "type": ["number", "null"], "minimum": 0, "description": "mg per 100 g" },
      "portions": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "required": ["amount", "unit", "grams"],
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "minLength": 1, "description": "cup, tablespoon, serving. USDA's 'RACC' is relabelled to 'serving' at build time." },
            "grams": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 }
          }
        }
      }
    }
  }
}
